// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Court {
  id             String   @id @default(uuid())
  name           String
  rating         Int?     @default(0)
  hourlyPrice    Decimal  @db.Decimal(10, 2) // Base hourly rate
  eventSurcharge Decimal? @db.Decimal(10, 2) // Additional fee for events
  isAvailable    Boolean  @default(true)
  isIndoor       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  address        String
  description    String?

  // Relationships
  categories CourtCategory[] // Sports this court supports
  facilities CourtFacility[] // Amenities available
  images     CourtImage[]
  bookings   Booking[] // All bookings for this court

  @@map("courts")
}

model Category {
  id       Int             @id @default(autoincrement())
  name     String          @unique
  courts   CourtCategory[]
  bookings Booking[] // Track which bookings use this sport type

  @@map("categories")
}

model Facility {
  id     Int             @id @default(autoincrement())
  name   String          @unique
  courts CourtFacility[]

  @@map("facilities")
}

model CourtCategory {
  courtId    String
  categoryId Int
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courtId, categoryId])
  @@map("court_categories")
}

model CourtFacility {
  courtId    String
  facilityId Int
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([courtId, facilityId])
  @@map("court_facilities")
}

model CourtImage {
  id           Int     @id @default(autoincrement())
  courtId      String
  court        Court   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  imageUrl     String
  altText      String?
  displayOrder Int     @default(0)
  isPrimary    Boolean @default(false)

  @@map("court_images")
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  startTime        DateTime
  endTime          DateTime
  notes            String?       @db.Text
  status           BookingStatus @default(PENDING_PAYMENT)
  expiresAt        DateTime
  totalPrice       Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(UNPAID)
  paymentMethod    String?
  paymentId        String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  courtId    String
  court      Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courtId, startTime, endTime], name: "unique_court_time_slot")
  @@index([courtId, startTime, endTime])
  @@index([categoryId])
  @@index([status, expiresAt])
  @@map("bookings")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  password    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isVerified  Boolean   @default(false)
  phoneNumber String?
  bookings    Booking[]

  @@map("users")
}
